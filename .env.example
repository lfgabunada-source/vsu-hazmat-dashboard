# Supabase connection (publishable/anon key — safe to expose; protected by RLS).
# The app also has these hard-coded as fallbacks in src/lib/supabase.ts,
# so the build works even if these are not set on the host.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
